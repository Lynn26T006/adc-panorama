}

export function getProductsWithFormulation(): ADCProduct[] {
  return store.filter(p =>
    p.dosageForm ||
    p.lyoExcipientsBuffer ||
    p.lyoExcipientsStabilizer ||
    p.lyoExcipientsSurfactant ||
    p.lyoPh ||
    p.lyoCycle ||
    p.storageCondition ||
    p.shelfLife ||
    p.liquidExcipients
  );
}

